{
  "env": {
    "doc": "The applicaton environment.",
    "format": ["production", "development", "test"],
    "default": "development",
    "env": "NODE_ENV"
  },

  "server": {
    "port": {
      "doc": "Port to bind",
      "format": "int",
      "default": 3100,
      "env": "API_SERVER_PORT"
    }
  },

  "httpSecret": {
    "doc": "Secret for HTTP basic auth (metrics). Required in production.",
    "default": "",
    "env": "HTTP_SECRET"
  },

  "adminPassword": {
    "doc": "Password for /api/admin (header X-Admin-Password). Required in production.",
    "default": "",
    "env": "ADMIN_PASSWORD"
  },

  "cookie": {
    "secret": {
      "doc": "Cookie encryption secret. Required in production.",
      "default": "",
      "env": "COOKIE_SECRET"
    },
    "isSecure": {
      "default": false,
      "env": "COOKIE_IS_SECURE"
    },
    "isSameSite": {
      "doc": "SameSite cookie attribute",
      "default": "Lax",
      "env": "COOKIE_SAME_SITE"
    },
    "ttl": {
      "doc": "Cookie TTL in milliseconds (30 days)",
      "format": "int",
      "default": 2592000000,
      "env": "COOKIE_TTL"
    }
  },

  "jwt": {
    "publicKeyPath": {
      "default": "../keys/jwt-public.pem",
      "env": "JWT_PUBLIC_KEY_PATH"
    }
  },

  "neo4j": {
    "uri": {
      "doc": "Neo4j Bolt URI. Required in production.",
      "default": "bolt://localhost:7687",
      "env": "NEO4J_URI"
    },
    "username": {
      "default": "neo4j",
      "env": "NEO4J_USERNAME"
    },
    "password": {
      "default": "huitparfait-local",
      "env": "NEO4J_PASSWORD"
    }
  }
}
