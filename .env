# Variables non sensibles (versionnées).
# Secrets et OAuth : voir .env.local (copier depuis .env.local.example).

NODE_ENV=development

# JWT : chemins relatifs à la racine du dépôt
JWT_PUBLIC_KEY_PATH=../keys/jwt-public.pem
JWT_PRIVATE_KEY_PATH=../keys/jwt-private.pem

# API (huitparfait-api)
API_SERVER_PORT=3100
COOKIE_IS_SECURE=false
COOKIE_SAME_SITE=Lax
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=huitparfait-local

# Auth (huitparfait-auth) : point d'entrée navigateur
SERVER_URL=http://localhost:3000
SERVER_PORT=3000
PROXY_API_URL=http://localhost:3100
PROXY_FRONT_URL=http://localhost:8081
CORS_ORIGIN=http://localhost:8081,http://localhost:3000

# Front (webpack dev)
FRONT_DEV_PORT=8081
API_URL=/api
