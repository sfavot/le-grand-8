{
  "env": {
    "doc": "The applicaton environment.",
    "format": ["production", "development", "test"],
    "default": "development",
    "env": "NODE_ENV"
  },

  "server": {
    "url": {
      "doc": "Server url",
      "default": "http://localhost:3000",
      "env": "SERVER_URL"
    },
    "port": {
      "doc": "Port to bind",
      "format": "int",
      "default": 3000,
      "env": "SERVER_PORT"
    }
  },

  "cors": {
    "origin": {
      "doc": "Comma-separated allowed CORS origins",
      "default": "http://localhost:8081",
      "env": "CORS_ORIGIN"
    }
  },

  "cookie": {
    "secret": {
      "doc": "Cookie encryption secret. Required in production.",
      "default": "",
      "env": "COOKIE_SECRET"
    },
    "isSecure": {
      "default": false,
      "env": "COOKIE_IS_SECURE"
    },
    "isSameSite": {
      "default": "Lax",
      "env": "COOKIE_SAME_SITE"
    },
    "ttl": {
      "doc": "Cookie TTL in milliseconds (30 days)",
      "format": "int",
      "default": 2592000000,
      "env": "COOKIE_TTL"
    }
  },

  "jwt": {
    "publicKeyPath": {
      "default": "../keys/jwt-public.pem",
      "env": "JWT_PUBLIC_KEY_PATH"
    },
    "privateKeyPath": {
      "default": "../keys/jwt-private.pem",
      "env": "JWT_PRIVATE_KEY_PATH"
    }
  },

  "proxy": {
    "apiUrl": {
      "default": "http://localhost:3100",
      "env": "PROXY_API_URL"
    },
    "frontUrl": {
      "default": "http://localhost:8081",
      "env": "PROXY_FRONT_URL"
    },
    "serveStaticFront": {
      "doc": "Sert le front compilé depuis public/ (Railway, Docker prod)",
      "format": "Boolean",
      "default": false,
      "env": "SERVE_STATIC_FRONT"
    }
  },

  "google": {
    "clientId": {
      "default": "",
      "env": "GOOGLE_CLIENT_ID"
    },
    "clientSecret": {
      "default": "",
      "env": "GOOGLE_CLIENT_SECRET"
    }
  }
}
