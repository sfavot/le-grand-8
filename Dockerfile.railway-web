# Service web Railway (auth + front). Build depuis la racine du dépôt :
#   Dockerfile path = Dockerfile.railway-web

FROM node:18-alpine AS front-build

WORKDIR /front

COPY huitparfait-front/package.json huitparfait-front/package-lock.json huitparfait-front/.npmrc ./
# chromedriver (e2e) échoue sur certaines plateformes : inutile pour le build
# .npmrc : legacy-peer-deps (Webpack 1 / karma-sinon-chai)
RUN npm ci --ignore-scripts

COPY huitparfait-front/ ./

ENV NODE_ENV=production

RUN npm run build

FROM node:22-alpine

WORKDIR /app

COPY huitparfait-auth/package.json huitparfait-auth/package-lock.json ./
RUN npm ci --omit=dev

COPY huitparfait-auth/config ./config
COPY huitparfait-auth/src ./src

COPY --from=front-build /front/dist ./public

ENV NODE_ENV=production
ENV SERVE_STATIC_FRONT=true

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s \
  CMD wget -qO- http://127.0.0.1:${PORT:-3000}/health || exit 1

CMD ["node", "src/server.js"]
