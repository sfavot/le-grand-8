# Variables pour le service Railway « web » (auth + front, URL publique + domaine custom).

NODE_ENV=production
SERVE_STATIC_FRONT=true

# URL publique du service (Railway → Settings → Generate Domain, ou domaine custom)
SERVER_URL=https://votre-app.up.railway.app
CORS_ORIGIN=https://votre-app.up.railway.app

COOKIE_SECRET=change-me-minimum-32-characters-long
COOKIE_IS_SECURE=true
COOKIE_SAME_SITE=Lax

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Réseau privé Railway (adapter « api » au nom exact du service API)
# Prérequis : variable PORT définie sur le service api (sinon ${{api.PORT}} est vide)
PROXY_API_URL=http://${{api.RAILWAY_PRIVATE_DOMAIN}}:${{api.PORT}}

# Coller le contenu PEM complet (pas JWT_*_PATH : les fichiers keys/ ne sont pas dans l'image Docker)
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
