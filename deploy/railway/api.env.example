# Variables pour le service Railway « huitparfait-api » (réseau privé, pas d'URL publique obligatoire).

NODE_ENV=production

# Railway injecte PORT au runtime (l'app écoute dessus via getServerPort()).
# Pour que le service « web » résolve ${{api.PORT}}, définir aussi PORT ici comme
# variable du service api (ex. 8080) — voir deploy/railway/DEPLOY.adoc.
# PORT=8080

HTTP_SECRET=change-me-minimum-32-characters-long
COOKIE_SECRET=change-me-minimum-32-characters-long
# Mot de passe /admin (header X-Admin-Password), distinct de HTTP_SECRET (obligatoire en prod)
ADMIN_PASSWORD=
COOKIE_IS_SECURE=true
COOKIE_SAME_SITE=Lax

# Neo4j Aura (Console Aura → Connect → URI)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Clé publique JWT (une ligne, ou \n échappés)
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
