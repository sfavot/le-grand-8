# Copier vers .env.local (non versionné) :
#   cp .env.local.example .env.local
#
# Ce fichier contient les secrets et surcharge .env.

HTTP_SECRET=change-me-minimum-32-characters-long
COOKIE_SECRET=change-me-minimum-32-characters-long

# Admin /admin (connexion Google + ce mot de passe, distinct de HTTP_SECRET).
ADMIN_PASSWORD=

# Google OAuth : https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production Railway (optionnel en local) :
# JWT_PUBLIC_KEY=...
# JWT_PRIVATE_KEY=...
# SERVE_STATIC_FRONT=true
# PROXY_API_URL=http://huitparfait-api.railway.internal:8080
